{
  "name": "cloudflare-next-intl-auth",
  "version": "0.1.0",
  "description": "Firebase Auth integration for Next.js App Router and Cloudflare",
  "main": "dist/src/firebase_auth/index.js",
  "types": "dist/src/firebase_auth/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/firebase_auth/index.d.ts",
      "import": "./dist/src/firebase_auth/index.js"
    },
    "./firebaseAuthClient": {
      "types": "./dist/src/firebase_auth/client/firebase_client.d.ts",
      "import": "./dist/src/firebase_auth/client/firebase_client.js"
    },
    "./firebaseAuthClientProvider": {
      "types": "./dist/src/firebase_auth/client/auth_user_provider.d.ts",
      "import": "./dist/src/firebase_auth/client/auth_user_provider.js"
    },
    "./firebaseAuthServerProvider": {
      "types": "./dist/src/firebase_auth/server/auth_user_server_provider.d.ts",
      "import": "./dist/src/firebase_auth/server/auth_user_server_provider.js"
    },
    "./useFirebaseAuthUser": {
      "react-server": {
        "types": "./dist/src/firebase_auth/server/use_auth_user_server.d.ts",
        "import": "./dist/src/firebase_auth/server/use_auth_user_server.js"
      },
      "default": {
        "types": "./dist/src/firebase_auth/client/use_auth_user.d.ts",
        "import": "./dist/src/firebase_auth/client/use_auth_user.js"
      }
    },
    "./getFirebaseAuthUser": {
      "types": "./dist/src/firebase_auth/server/auth_user_server.d.ts",
      "import": "./dist/src/firebase_auth/server/auth_user_server.js"
    },
    "./resolveOptionalAuthUser": {
      "types": "./dist/src/firebase_auth/server/resolve_optional_auth_user.d.ts",
      "import": "./dist/src/firebase_auth/server/resolve_optional_auth_user.js"
    },
    "./firebaseAuthActions": {
      "types": "./dist/src/firebase_auth/client/auth_actions.d.ts",
      "import": "./dist/src/firebase_auth/client/auth_actions.js"
    },
    "./firebaseAuthMiddleware": {
      "types": "./dist/src/firebase_auth/middleware/update_session.d.ts",
      "import": "./dist/src/firebase_auth/middleware/update_session.js"
    },
    "./checkFirebaseAuthConfig": {
      "types": "./dist/src/firebase_auth_check/index.d.ts",
      "import": "./dist/src/firebase_auth_check/index.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js"
    },
    "./normalizeConfig": {
      "types": "./dist/src/normalize_config.d.ts",
      "import": "./dist/src/normalize_config.js"
    },
    "./internal/updateSession": {
      "types": "./dist/src/firebase_auth/middleware/update_session.d.ts",
      "import": "./dist/src/firebase_auth/middleware/update_session.js"
    },
    "./internal/authUserServerProvider": {
      "types": "./dist/src/firebase_auth/server/auth_user_server_provider.d.ts",
      "import": "./dist/src/firebase_auth/server/auth_user_server_provider.js"
    },
    "./internal/autoPerformanceEvents": {
      "types": "./dist/src/firebase_auth/client/components/auto_firebase_performance_events.d.ts",
      "import": "./dist/src/firebase_auth/client/components/auto_firebase_performance_events.js"
    },
    "./internal/authUserProvider": {
      "types": "./dist/src/firebase_auth/client/auth_user_provider.d.ts",
      "import": "./dist/src/firebase_auth/client/auth_user_provider.js"
    },
    "./internal/useAuthUserServer": {
      "types": "./dist/src/firebase_auth/server/use_auth_user_server.d.ts",
      "import": "./dist/src/firebase_auth/server/use_auth_user_server.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/write_dist_type.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check:exports": "node scripts/check_exports.mjs",
    "check:size": "node scripts/check_size.mjs"
  },
  "keywords": [
    "nextjs",
    "cloudflare",
    "firebase",
    "firebase-auth",
    "app-check",
    "authentication"
  ],
  "author": "Demian Ilnutskyi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/demian-ilnytskyi/cloudflare-next-intl/issues"
  },
  "homepage": "https://github.com/demian-ilnytskyi/cloudflare-next-intl#readme",
  "dependencies": {
    "jose": "^6.2.8"
  },
  "peerDependencies": {
    "cloudflare-next-intl-intl": "^0.1.0",
    "@firebase/app": "0.x",
    "@firebase/app-check": "0.x",
    "@firebase/auth": "1.x",
    "@firebase/performance": "0.x",
    "next": ">=12.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || >=19.0.0-rc <19.0.0 || ^19.0.0",
    "typescript": ">=5.0.0",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.27.0",
    "@firebase/app": "^0.15.0",
    "@firebase/app-check": "^0.11.0",
    "@firebase/auth": "^1.12.0",
    "@firebase/performance": "^0.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "cloudflare-next-intl-intl": "file:../intl",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.3.3",
    "eslint-config-prettier": "^10.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "next": "^16.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^7.0.0",
    "vitest": "^3.0.8"
  }
}
