{
  "name": "cloudflare-next-intl-errors",
  "version": "0.1.1",
  "description": "Error reporting and stale deploy recovery for Next.js App Router and Cloudflare",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./errorHandling": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./installConsoleErrorOverride": {
      "types": "./dist/src/install_console_error_override.d.ts",
      "import": "./dist/src/install_console_error_override.js"
    },
    "./installGlobalErrorOverride": {
      "types": "./dist/src/install_global_error_override.d.ts",
      "import": "./dist/src/install_global_error_override.js"
    },
    "./stringifyUnknown": {
      "types": "./dist/src/stringify_unknown.d.ts",
      "import": "./dist/src/stringify_unknown.js"
    },
    "./formatErrorMessage": {
      "types": "./dist/src/format_error_message.d.ts",
      "import": "./dist/src/format_error_message.js"
    },
    "./defaultIgnoredConsoleErrors": {
      "types": "./dist/src/default_ignored_console_errors.d.ts",
      "import": "./dist/src/default_ignored_console_errors.js"
    },
    "./createServerErrorAction": {
      "types": "./dist/src/create_server_error_action.d.ts",
      "import": "./dist/src/create_server_error_action.js"
    },
    "./reportClientError": {
      "types": "./dist/src/report_client_error.d.ts",
      "import": "./dist/src/report_client_error.js"
    },
    "./isStaleDeployError": {
      "types": "./dist/src/is_stale_deploy_error.d.ts",
      "import": "./dist/src/is_stale_deploy_error.js"
    },
    "./clearClientCache": {
      "types": "./dist/src/clear_client_cache.d.ts",
      "import": "./dist/src/clear_client_cache.js"
    },
    "./useStaleDeployRecovery": {
      "types": "./dist/src/use_stale_deploy_recovery.d.ts",
      "import": "./dist/src/use_stale_deploy_recovery.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js"
    },
    "./staleDeployScripts": {
      "types": "./dist/src/stale_deploy_scripts.d.ts",
      "import": "./dist/src/stale_deploy_scripts.js"
    },
    "./internal/reportError": {
      "types": "./dist/src/report_error.d.ts",
      "import": "./dist/src/report_error.js"
    },
    "./internal/reportClientErrorAction": {
      "types": "./dist/src/report_client_error_action.d.ts",
      "import": "./dist/src/report_client_error_action.js"
    },
    "./internal/reportClientErrorCore": {
      "types": "./dist/src/report_client_error_core.d.ts",
      "import": "./dist/src/report_client_error_core.js"
    },
    "./internal/withErrorHandling": {
      "types": "./dist/src/with_error_handling.d.ts",
      "import": "./dist/src/with_error_handling.js"
    },
    "./internal/matchErrorMessage": {
      "types": "./dist/src/match_error_message.d.ts",
      "import": "./dist/src/match_error_message.js"
    },
    "./internal/mergeReportParams": {
      "types": "./dist/src/merge_report_params.d.ts",
      "import": "./dist/src/merge_report_params.js"
    }
  },
  "scripts": {
    "test": "vitest run --coverage",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "build": "rm -rf dist && tsc && node scripts/write_dist_type.mjs",
    "check:exports": "node scripts/check_exports.mjs",
    "check:size": "node scripts/check_size.mjs",
    "prepublishOnly": "npm run build && npm run check:exports && npm run check:size"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demian-ilnytskyi/cloudflare-next-intl.git",
    "directory": "packages/errors"
  },
  "keywords": [
    "nextjs",
    "errors",
    "error-handling",
    "stale-deploy",
    "cloudflare"
  ],
  "author": "Demian Ilnutskyi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/demian-ilnytskyi/cloudflare-next-intl/issues"
  },
  "homepage": "https://github.com/demian-ilnytskyi/cloudflare-next-intl/tree/main/packages/errors#readme",
  "dependencies": {},
  "peerDependencies": {
    "next": ">=12.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || >=19.0.0-rc <19.0.0 || ^19.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.27.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "next": "^16.2.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.0.8"
  }
}
