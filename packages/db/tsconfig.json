{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "removeComments": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "./dist/src"
  },
  "include": ["./**/*.ts", "./**/*.d.ts"],
  "exclude": ["**/*.test.ts", "**/*.bench.ts", "vitest.setup.ts", "vitest.config.ts", "dist/**"]
}
