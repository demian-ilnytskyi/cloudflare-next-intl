{
  "name": "cloudflare-next-intl-theme",
  "version": "0.1.0",
  "description": "Theme switcher and dark mode bootstrap script for Next.js App Router and Cloudflare",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./ThemeSwitcher": {
      "types": "./dist/src/components/theme_switcher.d.ts",
      "import": "./dist/src/components/theme_switcher.js"
    },
    "./ThemeSwitcherButton": {
      "types": "./dist/src/components/theme_switcher_button.d.ts",
      "import": "./dist/src/components/theme_switcher_button.js"
    },
    "./ThemeScript": {
      "types": "./dist/src/theme_script.d.ts",
      "import": "./dist/src/theme_script.js"
    },
    "./ClientThemeScript": {
      "types": "./dist/src/client_theme_script.d.ts",
      "import": "./dist/src/client_theme_script.js"
    },
    "./cookieKey": {
      "types": "./dist/src/cookie_key.d.ts",
      "import": "./dist/src/cookie_key.js"
    }
  },
  "scripts": {
    "test": "vitest run --coverage",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "prepare": "npm run build",
    "build": "rm -rf dist && tsc && node scripts/write_dist_type.mjs",
    "check:exports": "node scripts/check_exports.mjs",
    "check:size": "node scripts/check_size.mjs",
    "prepublishOnly": "npm run build && npm run check:exports && npm run check:size"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demian-ilnytskyi/cloudflare-next-intl.git"
  },
  "keywords": [
    "nextjs",
    "theme",
    "darkmode",
    "theme-switcher",
    "cloudflare"
  ],
  "author": "Demian Ilnutskyi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/demian-ilnytskyi/cloudflare-next-intl/issues"
  },
  "homepage": "https://github.com/demian-ilnytskyi/cloudflare-next-intl/tree/main/packages/theme#readme",
  "dependencies": {},
  "peerDependencies": {
    "next": ">=12.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || >=19.0.0-rc <19.0.0 || ^19.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.27.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "next": "^16.2.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.0.8"
  }
}
